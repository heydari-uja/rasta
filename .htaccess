RewriteEngine On
RewriteBase /

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)$ index.php [QSA,L]

RewriteEngine On
RewriteCond %{THE_REQUEST} !/public/ [NC]
RewriteCond %{THE_REQUEST} /(activities|lib|template|database|config|helpers|storage)/ [NC]
RewriteRule ^ - [R=403,L]

Options -Indexes
