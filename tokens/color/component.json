{
  "color": {
    "$type": "color",
    "component": {
      "button-primary-bg": { "$value": "{semantic.accent}" },
      "button-primary-bg-hover": { "$value": "{semantic.accent-hover}" },
      "button-primary-bg-pressed": { "$value": "{semantic.accent-hover}" },
      "button-primary-fg": { "$value": "{semantic.on-accent}" },
      "button-secondary-bg": { "$value": "{semantic.surface-muted}" },
      "button-secondary-border": { "$value": "{semantic.border-subtle}" },
      "button-secondary-border-hover": { "$value": "{semantic.border-strong}" },
      "button-secondary-fg": { "$value": "{semantic.text-primary}" },
      "button-quiet-bg": { "$value": "transparent" },
      "button-quiet-bg-hover": { "$value": "{semantic.surface-muted}" },
      "button-quiet-bg-pressed": { "$value": "{semantic.surface-muted}" },
      "button-quiet-fg": { "$value": "{semantic.text-muted}" },
      "button-quiet-fg-hover": { "$value": "{semantic.text-primary}" },
      "button-danger-bg": { "$value": "{semantic.status-danger}" },
      "button-danger-bg-hover": { "$value": "{semantic.status-danger-hover}" },
      "button-danger-bg-pressed": { "$value": "{semantic.status-danger-hover}" },
      "button-danger-fg": { "$value": "{semantic.on-accent}" },
      "field-bg": { "$value": "{semantic.surface-base}" },
      "field-border": { "$value": "{semantic.border-strong}" },
      "field-border-error": { "$value": "{semantic.status-danger}" },
      "field-fg": { "$value": "{semantic.text-primary}" },
      "field-placeholder": { "$value": "{semantic.text-muted}" }
    }
  }
}
