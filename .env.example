APP_NAME=Rasta
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# For production, set APP_ENV=production, APP_DEBUG=false, APP_URL to your HTTPS origin,
# and SESSION_SECURE_COOKIE=true. Set a unique temporary PIN before first Admin setup.
RASTA_BOOTSTRAP_PIN=
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
DB_CONNECTION=sqlite
SESSION_DRIVER=file
SESSION_LIFETIME=43200
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=single
