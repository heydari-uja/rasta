{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run tokens:build && vite build --configLoader runner",
    "dev": "concurrently -k -n tokens,vite \"node scripts/watch-color-tokens.mjs\" \"vite\"",
    "test:browser": "node scripts/browser-tests.mjs",
    "tokens:build": "node scripts/build-color-tokens.mjs",
    "tokens:watch": "node scripts/watch-color-tokens.mjs",
    "tokens:check": "node scripts/build-color-tokens.mjs --check",
    "check:colors": "node scripts/check-colors.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.0.0",
    "concurrently": "^9.0.1",
    "laravel-vite-plugin": "^2.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^7.0.7"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.2.5",
    "alpinejs": "^3.14.9",
    "lucide": "^0.468.0",
    "sortablejs": "^1.15.7"
  }
}
